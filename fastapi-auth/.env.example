# Application Settings
PROJECT_NAME="FastAPI Authentication Service"
API_V1_STR="/api/v1"
DEBUG=True

# Security / JWT Settings
# Generate a secure 32+ byte key (e.g. `openssl rand -hex 32`)
SECRET_KEY="super_secret_jwt_key_at_least_32_bytes_long_change_me_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database Configuration (MySQL / PyMySQL)
DB_HOST="localhost"
DB_PORT=3306
DB_USER="root"
DB_PASSWORD=""
DB_NAME="fastapi_auth_db"

# Optional direct connection string override:
# DATABASE_URL="mysql+pymysql://root:@localhost:3306/fastapi_auth_db"
# Or SQLite for quick local development without a MySQL server:
# DATABASE_URL="sqlite:///./fastapi_auth.db"
